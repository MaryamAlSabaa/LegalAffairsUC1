# PostgreSQL connection. Keep this file on the server only.
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/ku_legal_affairs
DATABASE_SSL=false

# The API listens on every network adapter so authorized users on the KU/LAN
# network can use the same database and protected document repository.
HOST=0.0.0.0
PORT=4000
NODE_ENV=development
SECURE_COOKIES=false

# Comma-separated browser origins allowed to call the API directly.
# Add this PC's LAN address when using the Vite development server.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_APP_URL=http://localhost:5173

# Absolute or server-relative central directory for shared PDF, Word, and Excel documents.
PDF_STORAGE_PATH=./storage/pdfs
SESSION_HOURS=12

# Optional SMTP configuration for password-reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=KU Legal Affairs <no-reply@example.edu>

# The default keeps PDF analysis local and produces a clearly labelled placeholder.
# Enable Gemini only after KU approves sending legal documents to that service.
USE_MOCK_AI_REVIEW=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
